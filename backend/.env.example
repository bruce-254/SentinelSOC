# SentinelSOC backend configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Database --------------------------------------------------------------
# PostgreSQL (production) or SQLite (local dev, default).
# DATABASE_URL=postgresql+psycopg2://sentinel:password@localhost:5432/sentinelsoc
DATABASE_URL=sqlite:///./sentinel.db

# --- Security ---------------------------------------------------------------
# !! REQUIRED in production: use a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_dev_secret_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
API_RATE_LIMIT=600
API_RATE_WINDOW_SECONDS=300

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
SECURE_LOGGING=true

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Default bootstrap admin (first run only) --------------------------------
DEFAULT_ORG_NAME=Default Organization
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin12345
DEFAULT_ADMIN_EMAIL=admin@sentinelsoc.local

# --- Threat intelligence -----------------------------------------------------
THREATINTEL_ENABLED=false
